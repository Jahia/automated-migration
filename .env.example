# Jahia instance targeted by probes, loaders, and the orchestrator.
# Copy to .env.local (gitignored) and set the values for YOUR machine —
# never commit real credentials, never hardcode them in probes or plans.

# Base URL of the running Jahia (docker/docker-compose.yml may remap the port,
# e.g. 8081:8080 — check `docker ps` before trusting the default).
JAHIA_URL=http://localhost:8080

# Super-user credentials (username and password as SEPARATE variables).
JAHIA_USER=root
JAHIA_PASS=root

# CSRF Origin header for GraphQL /modules/tools requests.
# MUST equal JAHIA_URL — a mismatched port is a hard, empty-body 403.
JAHIA_TOOLS_ORIGIN=http://localhost:8080
