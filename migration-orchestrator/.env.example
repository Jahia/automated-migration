# Configuration du serveur de migration-orchestrator
ORCHESTRATOR_OPENCODE_PORT=4096
ORCHESTRATOR_OPENCODE_HOSTNAME=127.0.0.1
# NOTE: cosmetic. The agent model is set in ~/.config/opencode/opencode.jsonc, NOT here.
ORCHESTRATOR_OPENCODE_MODEL=anthropic/claude-sonnet-4-5
ORCHESTRATOR_DB_PATH=orchestrator.db
ORCHESTRATOR_HOST=0.0.0.0
# API port — must match run.sh's ORCH_URL (default http://localhost:8001)
ORCHESTRATOR_PORT=8001

# GitHub (optionnel, pour les issues)
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# OpenCode (doit être configuré séparément)
# Voir https://opencode.ai/docs/providers/
