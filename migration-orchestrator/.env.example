# Configuration du serveur de migration-orchestrator
# Copier vers .env (gitignoré) et ajuster.
ORCHESTRATOR_DB_PATH=orchestrator.db
ORCHESTRATOR_HOST=0.0.0.0
# API port — must match run.sh's ORCH_URL (default http://localhost:8001)
ORCHESTRATOR_PORT=8001

# ── Direct LLM (OpenAI-compatible) — replaces OpenCode (P5.5) ──────────────
# Provider-agnostic: point base_url/model at any OpenAI-compatible endpoint.
# base_url and model have safe defaults in src/config.py; override only to swap
# provider or model. The API KEY has NO default and MUST be set here (or in the
# process env). Never commit a real key — .env is gitignored.
ORCHESTRATOR_LLM_API_KEY=
# ORCHESTRATOR_LLM_BASE_URL=https://api.deepseek.com/v1
# ORCHESTRATOR_LLM_MODEL=deepseek-v4-flash
# ORCHESTRATOR_LLM_TIMEOUT=180
# ORCHESTRATOR_LLM_MAX_RETRIES=3

# GitHub (optionnel, pour les issues)
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
