import { jahiaComponent, useServerContext } from "@jahia/javascript-modules-library";
import { createElement } from "react";
import { splitRoot, rootProps } from "$RELROOT/rawRoot.js";
import { composeNode } from "$RELROOT/skeletonRender.js";

/**
 * Skeleton view for $NODETYPE (generated — QUALITY-PLAN P2.5/C).
 * The node's `skeleton` property is its OWN captured markup; composeNode
 * substitutes lifted field values (title, body runs, linkLabel), media units
 * (verbatim by default, chosen image when edited), the contributor link and
 * the item child nodes — pixel-identical to the source when unedited, every
 * edit reflows into the exact same markup. See skeletonRender.ts.
 */
jahiaComponent(
  {
    componentType: "view",
    nodeType: "$NODETYPE",
    name: "default",
    displayName: "$DISPLAYNAME",
  },
  () => {
    const { currentNode } = useServerContext();
    const html = composeNode(currentNode as never);
    // render the fragment's REAL root element — child/sibling CSS selectors
    // (section spacing rules) must keep matching (display:contents does not
    // participate in selector matching)
    const root = splitRoot(html);
    if (root) {
      return createElement(root.tag, {
        ...rootProps(root.attrs),
        dangerouslySetInnerHTML: { __html: root.inner },
      });
    }
    return (
      // eslint-disable-next-line react/no-danger -- skeleton substitution is the mechanism
      <div style={{ display: "contents" }} dangerouslySetInnerHTML={{ __html: html }} />
    );
  },
);
