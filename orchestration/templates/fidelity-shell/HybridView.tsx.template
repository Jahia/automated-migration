import {
  jahiaComponent,
  useServerContext,
  RenderChild,
  RenderChildren,
  Island,
} from "@jahia/javascript-modules-library";
import { createElement, type ReactNode } from "react";
import type { JCRNodeWrapper } from "org.jahia.services.content";
import { splitRoot, rootProps } from "../rawRoot.js";
import {
  nodePayload,
  substitutePayload,
  childNodesOf,
  chunkTopLevel,
  hasSkeletonProp,
  fixFilesWorkspace,
} from "../skeletonRender.js";
import ArchetypeSection from "../ArchetypeSection.js";
import { resolveSemantic } from "../resolveSemantic.js";
import SourceCarousel from "../SourceCarousel.client.js";

/**
 * $DISPLAYNAME — HYBRID default view of $NODETYPE (contract v2, 2026-07-16).
 *
 * AUTHORABLE BY CONSTRUCTION: every visible content atom lives in PROPERTIES
 * (jcr:title, ONE body richtext, image weakref) or in CHILD NODES (ns:cardItem,
 * ns:cta). The node's captured skeleton carries ONLY structure (wrappers +
 * classes for the source CSS) with {{f:*}} markers resolved from properties.
 *
 * NESTED COMPONENTS ALWAYS RENDER THROUGH JAHIA'S PIPELINE — {{child:N}}
 * markers splice <RenderChild name="item-N">; markerless nodes with children
 * append <RenderChildren/>. Same path in EDIT and LIVE, so Page Builder gives
 * every nested component its edit frame and live renders each child's view.
 */
jahiaComponent(
  {
    componentType: "view",
    nodeType: "$NODETYPE",
    name: "$VIEWNAME",
    displayName: "$DISPLAYNAME",
  },
  (props: Record<string, unknown>) => {
    const { currentNode, renderContext } = useServerContext();
    const node = currentNode as never;

    if (!hasSkeletonProp(node)) {
      // fresh/semantic node: archetype layout from the properties
      const fields = resolveSemantic(props, currentNode as unknown as JCRNodeWrapper, renderContext);
      return <ArchetypeSection kind="$KIND" view="default" fields={fields} />;
    }

    // structure markup with property markers resolved; unresolved markers drop
    let live = false;
    try {
      live = Boolean((renderContext as { isLiveMode: () => boolean }).isLiveMode());
    } catch {
      live = false;
    }
    const p = nodePayload(node);
    const html = fixFilesWorkspace(
      substitutePayload(p).replace(/\{\{(?:f|media|link):[^}]+\}\}/g, ""),
      live,
    );
    const kids = childNodesOf(node);
    // CAPTURED carousel tracks froze without the source JS (dead arrows,
    // operator finding 2026-07-21): the SourceCarousel island adopts the
    // captured controls — markup stays byte-identical, behavior attaches
    let carouselId = "";
    if (html.includes('data-slot="carousel-item"')) {
      try {
        carouselId = `srccar-${(node as unknown as { getIdentifier: () => string }).getIdentifier()}`;
      } catch {
        carouselId = "";
      }
    }
    const withCarousel = (el: ReactNode): ReactNode =>
      carouselId
        ? createElement(
            "div",
            { id: carouselId, style: { display: "contents" } },
            el,
            createElement(Island as never, {
              component: SourceCarousel,
              props: { wrapperId: carouselId },
            }),
          )
        : el;

    if (html.includes("{{child:")) {
      const placed = new Set<number>();
      const compose = (fragment: string): ReactNode[] =>
        chunkTopLevel(fragment).map((c, i) => {
          if (c.kind === "child") {
            placed.add(c.idx);
            return createElement(
              "div",
              { key: `c${i}`, style: { display: "contents" } },
              createElement(RenderChild as never, { name: `item-${c.idx + 1}` }),
            );
          }
          if (c.html.includes("{{child:")) {
            const root = splitRoot(c.html);
            if (root) {
              return createElement(
                root.tag,
                { ...rootProps(root.attrs), key: `e${i}` },
                compose(root.inner),
              );
            }
            return createElement(
              "div",
              { key: `w${i}`, style: { display: "contents" } },
              compose(c.html),
            );
          }
          return createElement("div", {
            key: `h${i}`,
            style: { display: "contents" },
            dangerouslySetInnerHTML: { __html: c.html },
          });
        });
      const body = compose(html);
      const missed = kids
        .map((k, i) => [k, i] as const)
        .filter(([, i]) => !placed.has(i));
      return withCarousel(createElement(
        "div",
        { style: { display: "contents" } },
        body,
        missed.map(([k, i]) =>
          createElement(RenderChild as never, { key: `m${i}`, name: k.getName() })),
      ));
    }

    const root = splitRoot(html);
    const own = root
      ? createElement(root.tag, {
          ...rootProps(root.attrs),
          dangerouslySetInnerHTML: { __html: root.inner },
        })
      : createElement("div", {
          style: { display: "contents" },
          dangerouslySetInnerHTML: { __html: html },
        });
    if (kids.length > 0) {
      return withCarousel(createElement(
        "div",
        { style: { display: "contents" } },
        own,
        createElement(RenderChildren as never, {}),
      ));
    }
    return withCarousel(own);
  },
);
