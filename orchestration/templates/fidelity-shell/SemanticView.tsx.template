import { jahiaComponent, useServerContext } from "@jahia/javascript-modules-library";
import type { JCRNodeWrapper } from "org.jahia.services.content";
import ArchetypeSection from "../ArchetypeSection.js";
import { resolveSemantic } from "../resolveSemantic.js";

/**
 * $DISPLAYNAME — `$VIEWNAME` view of $NODETYPE (archetype kind: $KIND).
 *
 * Thin by design: it resolves the node's semantic fields once and hands the
 * MARKUP to the shared {@link ArchetypeSection} layout library, keyed by
 * (kind, view). A single content type can therefore expose several views that
 * differ only in layout; interaction (carousel controls) is delegated to an
 * island inside ArchetypeSection. Every visible string is a contributor-edited
 * field — nothing is hardcoded.
 */
jahiaComponent(
  {
    componentType: "view",
    nodeType: "$NODETYPE",
    name: "$VIEWNAME",
    displayName: "$DISPLAYNAME",
  },
  (props: Record<string, unknown>) => {
    const { currentNode, renderContext } = useServerContext();
    const node = currentNode as unknown as JCRNodeWrapper;
    const fields = resolveSemantic(props, node, renderContext);
    return <ArchetypeSection kind="$KIND" view="$VIEWNAME" fields={fields} />;
  },
);
