import { buildNodeUrl, server } from "@jahia/javascript-modules-library";
import { fixFilesWorkspace } from "./skeletonRender.js";
import type { JCRNodeWrapper } from "org.jahia.services.content";
import type { SemanticFields } from "./ArchetypeSection.js";

/**
 * resolveSemantic — the ONE place that maps a node's archetype fields onto the
 * {@link SemanticFields} surface every generated view hands to ArchetypeSection.
 *
 * Pulls the mix:title heading, rich-text body/subtitle/text, the DAM `image`
 * weakref (registering a cache dependency so the view invalidates when the
 * image changes, and using the image's own jcr:title as alt text), and the
 * linkTypeInitializer CTA (ctaType|j:linkType → j:linknode internal / j:url
 * external). Everything is optional at render time (Jahia guarantees nothing),
 * so every access is guarded.
 */
export function resolveSemantic(
  props: Record<string, unknown>,
  node: JCRNodeWrapper,
  renderContext: unknown,
): SemanticFields {
  let live = false;
  try {
    live = Boolean((renderContext as { isLiveMode: () => boolean }).isLiveMode());
  } catch {
    live = false;
  }
  // richtext values carry DAM /files/default/ URLs (loader asset rewrite);
  // anonymous LIVE readers need the live workspace segment
  const str = (k: string): string | undefined =>
    typeof props[k] === "string" && (props[k] as string).length
      ? fixFilesWorkspace(props[k] as string, live)
      : undefined;

  // DAM image (weakref) → URL + alt, with cache dependency on the image node
  const image = props.image as JCRNodeWrapper | undefined;
  let imgUrl: string | undefined;
  let imgAlt = str("jcr:title") ?? "";
  if (image) {
    try {
      imgUrl = buildNodeUrl(image);
      // eslint-disable-next-line @typescript-eslint/no-explicit-any
      server.render.addCacheDependency({ node: image }, renderContext as any);
      if (image.hasProperty("jcr:title")) imgAlt = image.getProperty("jcr:title").getString();
    } catch {
      /* image unresolved */
    }
  }

  // CTA — linkTypeInitializer writes j:linknode (internal) / j:url (external)
  let href: string | undefined;
  try {
    const typeProp = node.hasProperty("ctaType")
      ? "ctaType"
      : node.hasProperty("j:linkType")
        ? "j:linkType"
        : undefined;
    if (typeProp) {
      const lt = node.getProperty(typeProp).getString();
      if (lt === "internal" && node.hasProperty("j:linknode")) {
        href = buildNodeUrl(node.getProperty("j:linknode").getNode() as JCRNodeWrapper);
      } else if (lt === "external" && node.hasProperty("j:url")) {
        href = node.getProperty("j:url").getString();
      }
    }
  } catch {
    /* no CTA */
  }
  if (!href) {
    try {
      if (node.hasProperty("linkOrig")) {
        href = node.getProperty("linkOrig").getString();
      }
    } catch {
      /* no fallback */
    }
  }

  let hasChildren = false;
  try {
    hasChildren = node.getNodes().hasNext();
  } catch {
    hasChildren = false;
  }
  // MANDATE: the ORIGINAL site's class names, distilled at migration time
  // (hidden classMap prop) — the views wear them so the source CSS applies.
  let cls: Record<string, string> = {};
  try {
    if (node.hasProperty("classMap")) {
      cls = JSON.parse(node.getProperty("classMap").getString()) as Record<string, string>;
    }
  } catch {
    cls = {};
  }
  let editMode = false;
  try {
    editMode = (renderContext as { isEditMode: () => boolean }).isEditMode();
  } catch {
    editMode = false;
  }

  // site home URL — the header logo always links back to it
  let homeUrl: string | undefined;
  try {
    const site = (renderContext as { getSite: () => { getHome: () => JCRNodeWrapper } }).getSite();
    homeUrl = buildNodeUrl(site.getHome() as never);
  } catch {
    homeUrl = undefined;
  }
  // SLOT-NUMBERED rich text (2026-07-24): the loader keys a node's richtext
  // runs body, body2..bodyN (page-global slot numbers — a node may carry ONLY
  // body3). The skeleton view references slots by marker; the semantic surface
  // must aggregate them in order or the node renders empty (observed live:
  // every carousel card body sat in body2..4, invisible). Same for the CTA
  // label slots label/label2..N. Enumerate via node.getProperties() like
  // skeletonRender does — mixin-injected slot props are not guaranteed on the
  // props object.
  const bodySlots: Record<string, string> = {};
  const labelSlots: Record<string, string> = {};
  try {
    const it = node.getProperties();
    while (it.hasNext()) {
      const p = it.nextProperty();
      try {
        const name = String(p.getName());
        if (/^body\d*$/.test(name)) bodySlots[name] = p.getString();
        else if (/^label\d*$/.test(name)) labelSlots[name] = p.getString();
      } catch {
        /* unreadable prop — skip */
      }
    }
  } catch {
    /* not a JCR content node */
  }
  const slotNo = (k: string): number => {
    const n = k.replace(/^[a-z]+/i, "");
    return n === "" ? 1 : Number(n);
  };
  const bySlot = (a: string, b: string): number => slotNo(a) - slotNo(b);
  // skeleton marker order wins when captured — slot NUMBERS are page-global
  // and can invert intra-node order (the hero panel heading is body2, the
  // quick links body: numeric order put the links first)
  const bodyOrder = typeof cls.bodyOrder === "string" ? cls.bodyOrder.split(" ") : [];
  const byOrder = (a: string, b: string): number => {
    const ia = bodyOrder.indexOf(a);
    const ib = bodyOrder.indexOf(b);
    if (ia >= 0 && ib >= 0) return ia - ib;
    if (ia >= 0 || ib >= 0) return ia >= 0 ? -1 : 1;
    return bySlot(a, b);
  };
  const bodies = Object.keys(bodySlots)
    .sort(byOrder)
    .map((k) => fixFilesWorkspace(bodySlots[k], live))
    .filter((v) => v.trim().length > 0);
  const label =
    str("ctaLabel") ??
    str("linkLabel") ??
    Object.keys(labelSlots)
      .sort(bySlot)
      .map((k) => labelSlots[k])
      .find((v) => v.trim().length > 0);
  return {
    homeUrl,
    title: str("jcr:title"),
    subtitle: str("subtitle"),
    body: bodies.length ? bodies.join("\n") : undefined,
    text: str("text"),
    imgUrl,
    imgAlt,
    href,
    ctaLabel: label,
    hasChildren,
    editMode,
    cls,
    trackId: `carousel-${node.getIdentifier()}`,
  };
}
