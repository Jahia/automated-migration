import { RenderChildren, Island } from "@jahia/javascript-modules-library";
import type { ReactNode } from "react";
import CarouselControls from "./CarouselControls.client.js";

/**
 * ArchetypeSection — the shared, hand-authored layout library for the semantic
 * archetype model (redesign §10). Every generated `<view>.server.tsx` resolves
 * its node's semantic fields and delegates the MARKUP to this one component,
 * keyed by (kind, view). This is what gives each archetype a PROPER render
 * (a hero renders as a hero, a card grid lays children out as a grid, a
 * carousel gets prev/next controls) instead of one generic props dump — and
 * lets a single component expose several views (default / textUp / carousel /
 * fullPage / …) that differ only in layout.
 *
 * Interaction that needs the client (carousel scrolling) is delegated to an
 * <Island>; the slides themselves stay server-rendered + Page-Builder-editable.
 * Accordions use native <details>/<summary> — accessible with no JS.
 *
 * Styling is intentionally class-based (no CSS-modules): the migrated site's
 * own imported CSS (css-manifest) targets these stable class names, so the
 * archetype markup inherits the source design without re-authoring it.
 */
export interface SemanticFields {
  homeUrl?: string;
  title?: string;
  subtitle?: string;
  body?: string; // rich-text HTML
  text?: string; // secondary rich-text HTML
  imgUrl?: string;
  imgAlt?: string;
  href?: string; // resolved CTA target
  ctaLabel?: string;
  hasChildren: boolean;
  editMode?: boolean;
  cls?: Record<string, string>;
  trackId?: string; // stable id for the carousel island to scroll
}

const CONTAINER_KINDS = new Set([
  "cardGrid",
  "cols",
  "section",
  "accordion",
  "jcrQuery",
  "siteHeader",
  "footer",
]);

function Rich({ html, className }: { html?: string; className?: string }): ReactNode {
  return typeof html === "string" && html.trim() ? (
    <div className={className} dangerouslySetInnerHTML={{ __html: html }} />
  ) : null;
}

function Cta({ href, label }: { href?: string; label?: string }): ReactNode {
  const usable = href && href !== "#";
  if (!label && !usable) return null;
  return usable ? (
    <a href={href} className="cta">
      {label || href}
    </a>
  ) : (
    <span className="cta cta--unlinked">{label}</span>
  );
}

function Img({
  url,
  alt,
  className,
  w,
  h,
}: {
  url?: string;
  alt?: string;
  className?: string;
  w?: string;
  h?: string;
}): ReactNode {
  // w/h = the SOURCE's explicit img sizing, recovered from the DAM lift
  // (classMap imageW/imageH) — without them a 30px icon renders at the DAM
  // file's natural size (height-explosion class, 2026-07-24)
  return url ? (
    <img
      src={url}
      alt={alt ?? ""}
      className={className}
      loading="lazy"
      {...(w && /^\d+$/.test(w) ? { width: Number(w) } : {})}
      {...(h && /^\d+$/.test(h) ? { height: Number(h) } : {})}
    />
  ) : null;
}

/** source class + semantic fallback: the ORIGINAL CSS styles the markup;
 *  the semantic class stays as the structural safety net. */
const mc = (source: string | undefined, fallback: string): string =>
  source && source.trim() ? `${source} ${fallback}` : fallback;

/** SOURCE-ANATOMY split (2026-07-24 layout campaign): the capture distills the
 *  band's wrapper CHAIN and its media/text column split into classMap slots
 *  (chain / cols / bodyOrder — see _distill_classmap). Reproducing that
 *  nesting matters because the source's grid/flex CSS is structure-sensitive:
 *  a flattened wrapper tree stacks what the source lays out side-by-side. */
interface SourceCol {
  cls: string;
  role: string;
  chain?: string;
  hasTitle?: boolean;
}
function parseCols(v?: string): SourceCol[] | null {
  if (!v) return null;
  try {
    const a = JSON.parse(v) as SourceCol[];
    return Array.isArray(a) && a.length === 2 && a.some((c) => c.role === "media") ? a : null;
  } catch {
    return null;
  }
}
/** wrap `inner` in the captured single-child wrapper tiers (outermost first) */
function chainWrap(inner: ReactNode, chain?: string): ReactNode {
  const tiers = (chain || "").split("|").filter(Boolean);
  for (let i = tiers.length - 1; i >= 0; i--) {
    inner = <div className={tiers[i]}>{inner}</div>;
  }
  return inner;
}

export default function ArchetypeSection({
  kind,
  view,
  fields: f,
}: {
  kind: string;
  view: string;
  fields: SemanticFields;
}): ReactNode {
  const cls = f.cls ?? {};
  // the body may still CONTAIN the heading markup (last-resort sweep keeps
  // source structure) — never render the title twice
  const titleInBody = !!(f.title && f.body && f.body.includes(f.title));
  const heading = f.title && !titleInBody
    ? <h2 className={mc(cls.title, "title")}>{f.title}</h2> : null;
  const subtitle = f.subtitle ? <p className="subtitle">{f.subtitle}</p> : null;
  const isContainer = CONTAINER_KINDS.has(kind);
  // Always expose the child drop-zone for containers (so Page Builder shows the
  // insertion Area even when empty); otherwise only when children exist.
  // EVERY case below must render childSlot — child nodes are contributed
  // content and a view that drops them makes real data unrenderable (footer
  // columns rendered title-only while their cta children sat in the JCR,
  // 2026-07-20; chrome-render-check gates this class).
  const childSlot = isContainer || f.hasChildren ? <RenderChildren /> : null;

  // shared source-anatomy renderer for hero/mediaText default views: the two
  // captured columns render IN DOCUMENT ORDER (reversed bands stay reversed),
  // each wearing its source classes + inner wrapper tiers
  const renderSplit = (split: SourceCol[], h: ReactNode): ReactNode =>
    chainWrap(
      <>
        {split.map((c, i) =>
          c.role === "media" ? (
            <div key={i} className={c.cls}>
              {c.hasTitle ? h : null}
              {chainWrap(<Img url={f.imgUrl} alt={f.imgAlt} className={cls.image} w={cls.imageW} h={cls.imageH} />, c.chain)}
            </div>
          ) : (
            <div key={i} className={c.cls}>
              {chainWrap(
                <>
                  {!split.some((x) => x.role === "media" && x.hasTitle) ? h : null}
                  {subtitle}
                  <Rich html={f.body} />
                  <Cta href={f.href} label={f.ctaLabel} />
                  {childSlot}
                </>,
                c.chain,
              )}
            </div>
          ),
        )}
      </>,
      cls.chain,
    );
  const splitCols = parseCols(cls.cols);
  if (splitCols && view === "default" && (kind === "hero" || kind === "mediaText")) {
    const h = kind === "hero"
      ? (f.title ? <h1 className={mc(cls.title, "title")}>{f.title}</h1> : null)
      : heading;
    return (
      <section className={mc(cls.root, `${kind === "hero" ? "hero hero--source" : "media-text media-text--source"} ${kind}`)}>
        {renderSplit(splitCols, h)}
      </section>
    );
  }

  switch (kind) {
    // ─── HERO: full-bleed cover; text order flips per view ──────────────────
    case "hero": {
      const text = (
        <div className="hero-text">
          {f.title ? <h1 className="title">{f.title}</h1> : null}
          {subtitle}
          <Rich html={f.body} className="hero-body" />
          <Cta href={f.href} label={f.ctaLabel} />
          {childSlot}
        </div>
      );
      const media = <Img url={f.imgUrl} alt={f.imgAlt} className={f.cls?.image} w={f.cls?.imageW} h={f.cls?.imageH} />;
      if (view === "textDown") {
        return (
          <section className={`hero hero--textDown ${kind}`}>
            {media}
            {text}
          </section>
        );
      }
      if (view === "textUp") {
        return (
          <section className={`hero hero--textUp ${kind}`}>
            {text}
            {media}
          </section>
        );
      }
      // default: text overlaid on the cover image
      return (
        <section className={mc(cls.root, `hero hero--cover ${kind}`)}>
          {media}
          <div className="hero-overlay">{text}</div>
        </section>
      );
    }

    // ─── MEDIA + TEXT: image beside prose ───────────────────────────────────
    case "mediaText":
      return (
        <section className={mc(cls.root, `media-text ${kind}`)}>
          <div className="media-text__media">
            <Img url={f.imgUrl} alt={f.imgAlt} className={f.cls?.image} w={f.cls?.imageW} h={f.cls?.imageH} />
          </div>
          <div className="media-text__body">
            {heading}
            {subtitle}
            <Rich html={f.body} />
            <Cta href={f.href} label={f.ctaLabel} />
            {childSlot}
          </div>
        </section>
      );

    // ─── BANNER: full-width call-to-action band ─────────────────────────────
    case "banner":
      // the band's photo IS the banner (source: absolute cover behind the
      // inner content) — dropping it left white text on the fallback gray
      // (Support & Service Updates, 2026-07-24)
      return (
        <section className={mc(cls.root, `banner ${kind}`)}>
          <Img url={f.imgUrl} alt={f.imgAlt} className={mc(cls.image, "banner__media")} w={cls.imageW} h={cls.imageH} />
          {/* the captured wrapper tiers carry the band's own background
              (Support & Service Updates: a blue gradient) — without them the
              white source text sits invisible on the fallback gray */}
          {chainWrap(
            <div className="banner__inner">
              {heading}
              <Rich html={f.body} />
              <Cta href={f.href} label={f.ctaLabel} />
              {childSlot}
            </div>,
            cls.chain,
          )}
        </section>
      );

    // ─── STAT CALLOUT: big figure + label ───────────────────────────────────
    case "statCallout":
      return (
        <section className={`stat ${kind}`}>
          {f.title ? <span className="stat__figure">{f.title}</span> : null}
          <Rich html={f.body} className="stat__label" />
          {childSlot}
        </section>
      );

    // ─── RICH TEXT / generic prose ──────────────────────────────────────────
    case "richTextSection":
      return (
        <section className={mc(cls.root, `rich-text ${kind}`)}>
          {heading}
          <Rich html={f.body} />
          {childSlot}
        </section>
      );

    // ─── CARD GRID: grid, or carousel (island-driven controls) ──────────────
    case "cardGrid":
      if (view === "carousel") {
        // skill rule: interactive components render FLAT in edit mode with an
        // editor hint — sliding UI is hostile to selection and reordering
        if (f.editMode) {
          return (
            <section className={mc(cls.root, `card-grid ${kind}`)}>
              {heading}
              <Rich html={f.body} className="card-grid__intro" />
              <div className={mc(cls.items, "card-grid__items")}>{childSlot}</div>
              <p className="editor-hint">Carousel — add or reorder slides here</p>
            </section>
          );
        }
        return (
          <section className={mc(cls.root, `card-grid card-grid--carousel ${kind}`)}>
            {heading}
            <div className="carousel-track" id={f.trackId}>
              {childSlot}
            </div>
            {f.trackId ? <Island component={CarouselControls} props={{ trackId: f.trackId }} /> : null}
          </section>
        );
      }
      return (
        <section className={mc(cls.root, `card-grid ${kind}`)}>
          {heading}
          <Rich html={f.body} className="card-grid__intro" />
          <div className={mc(cls.items, "card-grid__items")}>{childSlot}</div>
        </section>
      );

    // ─── ACCORDION: native details/summary per child (no JS needed) ─────────
    case "accordion":
      return (
        <section className={mc(cls.root, `accordion ${kind}`)}>
          {heading}
          <Rich html={f.body} />
          <div className="accordion__items">{childSlot}</div>
        </section>
      );

    // ─── ACCORDION ITEM: native disclosure (accessible, zero JS) ────────────
    case "accordionItem":
      return (
        <details className={`accordion__item ${kind}`}>
          <summary>{f.title}</summary>
          <div className="accordion__panel">
            <Rich html={f.body} />
            {f.hasChildren ? <RenderChildren /> : null}
          </div>
        </details>
      );

    // ─── TEASER CARD: image + title + excerpt + CTA (compact drops excerpt) ─
    case "teaserCard": {
      const compact = view === "compact";
      return (
        <article className={mc(cls.root, `card ${kind}${compact ? " card--compact" : ""}`)}>
          {chainWrap(
            <Img url={f.imgUrl} alt={f.imgAlt} className={f.cls?.image} w={f.cls?.imageW} h={f.cls?.imageH} />,
            cls.imageChain,
          )}
          <div className="card__body">
            {f.title ? <h3 className="title">{f.title}</h3> : null}
            {!compact ? <Rich html={f.body} className="card__excerpt" /> : null}
            <Cta href={f.href} label={f.ctaLabel} />
            {childSlot}
          </div>
        </article>
      );
    }

    // ─── COLUMNS ────────────────────────────────────────────────────────────
    case "cols":
      return (
        <div className={`cols ${kind}`}>
          {heading}
          <Rich html={f.body} />
          <div className="cols__row">{childSlot}</div>
        </div>
      );

    // ─── ARTICLE / EVENT (mainResource): full page vs teaser cards ──────────
    case "article":
    case "event": {
      if (view === "fullPage") {
        return (
          <article className={`article article--full ${kind}`}>
            {f.title ? <h1 className="title">{f.title}</h1> : null}
            {subtitle}
            <Img url={f.imgUrl} alt={f.imgAlt} className={f.cls?.image} w={f.cls?.imageW} h={f.cls?.imageH} />
            <Rich html={f.body} />
            {f.hasChildren ? <RenderChildren /> : null}
          </article>
        );
      }
      // card / compact / featured / cm teasers
      const teaser = view === "default" ? "card" : view;
      return (
        <article className={`article-teaser article-teaser--${teaser} ${kind}`}>
          {chainWrap(
            <Img url={f.imgUrl} alt={f.imgAlt} className={f.cls?.image} w={f.cls?.imageW} h={f.cls?.imageH} />,
            cls.imageChain,
          )}
          <div className="article-teaser__body">
            {f.title ? <h3 className="title">{f.title}</h3> : null}
            {view !== "compact" ? <Rich html={f.body} className="excerpt" /> : null}
            <Cta href={f.href} label={f.ctaLabel} />
            {childSlot}
          </div>
        </article>
      );
    }

    // ─── CTA child object: one link, orderable, 0..N per component ──────────
    case "ctaLink":
      return childSlot ? (
        <>
          <Cta href={f.href} label={f.ctaLabel || f.title} />
          {childSlot}
        </>
      ) : (
        <Cta href={f.href} label={f.ctaLabel || f.title} />
      );

    // ─── SITE HEADER / FOOTER chrome ────────────────────────────────────────
    case "siteHeader":
      return (
        <header className={mc(cls.root, `site-header ${kind}`)}>
          <div className="site-header__inner">
            {/* the logo ALWAYS links back to home (operator review 2026-07-17) */}
            <a href={f.homeUrl || "/"} className="site-header__logohome" aria-label="Home">
              <Img url={f.imgUrl} alt={f.title || "logo"} className="site-header__logo" />
            </a>
            <div className="site-header__links">{childSlot}</div>
          </div>
        </header>
      );
    case "footer": {
      // SOURCE MODE (2026-07-20): when the capture stamped wrapper classes
      // (classMap columns/legal), the source CSS owns the footer's look —
      // site-footer--source disables the semantic fallback THEME (scoped in
      // semantic.css via :not) while the structural grid rules stay.
      const srcMode = !!(cls.columns || cls.legal);
      return (
        <footer
          className={mc(cls.root, `site-footer${srcMode ? " site-footer--source" : ""} ${kind}`)}
        >
          <div className={mc(cls.columns, "site-footer__columns")}>{childSlot}</div>
          <Rich html={f.body} className={mc(cls.legal, "site-footer__legal")} />
        </footer>
      );
    }

    // ─── GENERIC SECTION (section / jcrQuery / unknown): title + body + drop ─
    default:
      return (
        <section className={mc(cls.root, `section ${kind}`)}>
          {heading}
          {subtitle}
          {chainWrap(
            <Img url={f.imgUrl} alt={f.imgAlt} className={f.cls?.image} w={f.cls?.imageW} h={f.cls?.imageH} />,
            cls.imageChain,
          )}
          <Rich html={f.body} />
          <Cta href={f.href} label={f.ctaLabel} />
          {childSlot}
        </section>
      );
  }
}
