        { "componentType": "usg:imgContentBlock", "view": "default", "heading": "Jeune & enfants", "imageUrl": "/-/media/Project/Comexposium-Master1/Master1-Supercar/billetterie/enfant-ado.jpg", "body": "<p>Vivez l'expérience Ultimate Supercar en famille !</p><ul><li>Jeunes (-16 ans) : En vente sur place uniquement</li><li>Enfants (-12 ans) : GRATUIT</li></ul>" },
        { "componentType": "usg:imgContentBlock", "view": "alt", "heading": "En situation de handicap", "imageUrl": "/-/media/Project/Comexposium-Master1/Master1-Supercar/billetterie/situation-de-handicap.png", "body": "<p>L'événement accueille tous ses visiteurs dans les meilleures conditions.</p>", "ctaLabel": "Les engagements d'accessibilité", "ctaLink": "https://www.retromobile.com/fr-FR/infos-pratiques/nos-engagements-accessibilite" },
