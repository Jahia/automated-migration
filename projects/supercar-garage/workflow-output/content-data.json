    {
      "url": "/fr-FR/evenement/les-univers",
      "title": "Les univers",
      "language": "fr",
      "heroBanner": { "heading": "Les univers", "backgroundImage": "/-/media/Project/Comexposium-Master1/Master1-Supercar/hp-visiteurs/evenement/stand-constructeurs.jpg" },
      "sections": [
        { "componentType": "usg:richText", "body": "Ultimate Supercar Garage déploie un écosystème unique où la supercar se vit sous toutes ses formes. Constructeurs visionnaires, marchands d'exception, artisans du luxe automobile, préparateurs et univers lifestyle composent une expérience où héritage, création et émotion dialoguent sans frontière." },
        { "componentType": "usg:editorialBlock", "view": "default", "heading": "CONSTRUCTEURS", "subheading": "Les signatures qui dessinent les supercars d'aujourd'hui", "imageUrl": "/-/media/Project/Comexposium-Master1/Master1-Supercar/hp-visiteurs/les-univers/constructeurss.jpg", "body": "<p>Ultimate Supercar Garage réunit, en un même lieu, les constructeurs les plus désirables de la scène supercar contemporaine. Bugatti, Pagani, Aston Martin, Ferrari, Maserati... des maisons iconiques aux signatures affirmées, réunies autour d'une même exigence : faire de l'automobile une œuvre de design et de technologie.</p>" },
        { "componentType": "usg:editorialBlock", "view": "rightImg", "heading": "ARTISANS DU LUXE AUTOMOBILE", "subheading": "Là où l'artisanat façonne l'exception", "imageUrl": "/-/media/Project/Comexposium-Master1/Master1-Supercar/hp-visiteurs/les-univers/artisans-du-luxe.jpg", "body": "<p>Ultimate Supercar Garage met en lumière une sélection rare de créateurs qui proposent une nouvelle vision de la supercar contemporaine.</p>", "ctaLabel": "Découvrir les artisans du luxe automobile", "ctaLink": "/fr-FR/exposants-et-animations/liste-des-exposants" },
        { "componentType": "usg:editorialBlock", "view": "default", "heading": "PRÉPARATEURS & MARCHANDS D'EXCEPTION", "subheading": "Les références du marché supercar", "imageUrl": "/-/media/Project/Comexposium-Master1/Master1-Supercar/hp-visiteurs/les-univers/preparateurs-et-marchants.jpg", "body": "<p>Les plus prestigieux marchands européens spécialisés dans les supercars et hypercars contemporaines sont réunis.</p>" },
        { "componentType": "usg:richText", "heading": "CLUBS DE SUPERCARS", "body": "<h3>La passion partagée</h3><p>Ultimate Supercar Garage accueille les clubs de supercars les plus exclusifs.</p>" },
        { "componentType": "usg:ctaBanner", "ctaLabel": "Découvrir les clubs de supercar", "linkTarget": "/fr-FR/exposants-et-animations/liste-des-exposants" },
        { "componentType": "usg:imageBlock", "imageUrl": "/-/media/Project/Comexposium-Master1/Master1-Supercar/hp-visiteurs/les-univers/clubs-de-supercars.jpg" },
        { "componentType": "usg:editorialBlock", "view": "verticalImage", "heading": "GALERIE \"ART OF LIFE\"", "subheading": "L'expérience supercar à chaque instant", "imageUrl": "/-/media/Project/Comexposium-Master1/Master1-Supercar/hp-visiteurs/les-univers/galerie-art.jpg", "body": "<p>Plus qu'un véhicule, une supercar est une expérience. Une émotion. Un art de vivre.</p>" },
        { "componentType": "usg:editorialBlock", "view": "verticalImage", "heading": "Devenir exposant", "imageUrl": "/-/media/Project/Comexposium-Master1/Master1-Supercar/hp-exposants/offre-de-stand/artisans-lounge.jpg", "body": "Positionnez votre marque parmi les constructeurs et artisans.", "ctaLabel": "Découvrez nos offres exposants", "ctaLink": "/fr-FR/espace-exposant" },
        { "componentType": "usg:editorialBlock", "view": "verticalImage", "heading": "Prenez part à l'expérience dès l'ouverture !", "imageUrl": "/-/media/Project/Comexposium-Master1/Master1-Supercar/CP/cp-billeterie.jpg", "body": "Soyez les premiers informés de l'ouverture de la billetterie 2027.", "ctaLabel": "M'inscrire pour 2027", "ctaLink": "https://dweb.typeform.com/to/bKR7YAo6" }
      ]
    },
    {
      "url": "/fr-FR/evenement/scene-live",
      "title": "Scène Live",
      "language": "fr",
      "heroBanner": { "heading": "Scène Live", "backgroundImage": "/-/media/Project/Comexposium-Master1/Master1-Supercar/hp-visiteurs/evenement/pivot-scene-live.jpg" },
      "sections": [
        { "componentType": "usg:richText", "body": "<p>Au cœur de l'Ultimate Supercar Garage, la scène live s'impose comme le véritable moteur de l'événement. Lancements en avant-première de supercars, rencontres avec des designers de renommée mondiale, interventions d'influenceurs — la scène rythmera chaque journée.</p>" },
        { "componentType": "usg:editorialBlock", "view": "default", "heading": "Au cœur de l'expérience", "imageUrl": "/-/media/Project/Comexposium-Master1/Master1-Supercar/hp-visiteurs/scene-live/presentation-scenelive.jpg", "body": "<p>Cœur battant de l'Ultimate Supercar Garage, la Scène Live transforme la présentation automobile en expérience spectaculaire.</p>" },
        { "componentType": "usg:editorialBlock", "view": "rightImg", "heading": "Révélations exclusives", "imageUrl": "/-/media/Project/Comexposium-Master1/Master1-Supercar/hp-visiteurs/scene-live/scenelive.jpg", "body": "<p>Lors de la 1ère édition, des maisons prestigieuses comme Bugatti et Donkervoort ont choisi cette scène pour dévoiler leur dernier modèle.</p>" },
        { "componentType": "usg:editorialBlock", "view": "default", "heading": "Design in Motion : Paris vibre au rythme du design de supercar", "imageUrl": "/-/media/Project/Comexposium-Master1/Master1-Supercar/hp-visiteurs/scene-live/design-in-motion.jpg", "body": "<p>Fil conducteur de la Scène Live, le design s'impose comme le langage central.</p>" },
